---
const { heading } = Astro.props;
---

<li>
  <a href={`#${heading.slug}`}>
    {heading.text}
  </a>

  {
    heading.subheadings.length > 0 && (
      <ul class="flex flex-col list-disc list-inside">
        {heading.subheadings.map((subheading: typeof heading) => (
          <Astro.self heading={subheading} />
        ))}
      </ul>
    )
  }
</li>
