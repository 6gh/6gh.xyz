---
import type { MDXInstance } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  post: MDXInstance<Record<string, any>>;
}

const { post } = Astro.props;
---

<div class="card w-96 z-0 group">
  <Image
    class="z-20"
    src={post.frontmatter.image.url}
    alt={post.frontmatter.image.alt}
    width="384"
    height="384"
  />
  <Image
    class="absolute blur-lg z-10 opacity-55"
    src={post.frontmatter.image.url}
    alt={post.frontmatter.image.alt}
    width="384"
    height="384"
  />
  <p class="text-sm italic opacity-60">{new Date(post.frontmatter.pubDate).toLocaleDateString()}</p>
  <h1 class="font-bold text-lg group-hover:underline">
    <a href={post.url}>
      {post.frontmatter.title}
    </a>
  </h1>
  <p>{post.frontmatter.description}</p>
  <ul class="flex gap-1 flex-wrap">
    {post.frontmatter.tags.map((tag: string) => (
      <li><a href={`/blog/tag/${tag}`} class="btn btn-sm">{tag}</a></li>
    ))}
  </ul>
  <slot />
</div>
