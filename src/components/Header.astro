---
import ThemeChanger from "./ThemeChanger.astro";
---

<nav class="content-container top-0 left-0 right-0 flex justify-between items-center py-3 font-heading backdrop-blur-md bg-background-50 border-b-background-300 border-b-2">
  <a href="/" class="text-xl font-bold">6gh.dev</a>
  <ul class="hidden md:flex gap-8">
    <li><a href="/about" class="hover:text-typing">
        About Me
    </a></li>
    <li><a href="/blog" class="hover:text-typing">
        Blog
    </a></li>
    <li><a href="/midis" class="hover:text-typing">
        MIDIs
    </a></li>
    <li><a href="/portfolio" class="hover:text-typing">
        Portfolio
    </a></li>
  </ul>
  <ThemeChanger />
</nav>

<style>
  .hover\:text-typing:hover {
    @apply relative after:inline-block after:absolute after:animate-pulse;
  }
  .hover\:text-typing:hover::after {
    content: "|";
    right: 0;
    height: 100%;
    color: white;
  }
</style>
