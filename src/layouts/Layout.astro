      --text-600: #335599;
      --text-700: #264073;
      --text-800: #192a4d;
      --text-900: #0d1526;
      --text-950: #060b13;
      
      --background-50: #f1f2f4;
      --background-100: #e3e5e8;
      --background-200: #c7cad1;
      --background-300: #abb0ba;
      --background-400: #8f96a3;
      --background-500: #737b8c;
      --background-600: #5c6370;
      --background-700: #454a54;
      --background-800: #2e3138;
      --background-900: #17191c;
      --background-950: #0b0c0e;
      
      --primary-50: #ebf0f9;
      --primary-100: #d7e1f4;
      --primary-200: #afc2e9;
      --primary-300: #88a4dd;
      --primary-400: #6086d2;
      --primary-500: #3868c7;
      --primary-600: #2d539f;
      --primary-700: #223e77;
      --primary-800: #162950;
      --primary-900: #0b1528;
      --primary-950: #060a14;
      
      --secondary-50: #ebf0fa;
      --secondary-100: #d6e0f5;
      --secondary-200: #adc2eb;
      --secondary-300: #85a3e0;
      --secondary-400: #5c85d6;
      --secondary-500: #3366cc;
      --secondary-600: #2952a3;
      --secondary-700: #1f3d7a;
      --secondary-800: #142952;
      --secondary-900: #0a1429;
      --secondary-950: #050a14;
      
      --accent-50: #eaf0fa;
      --accent-100: #d5e0f6;
      --accent-200: #abc1ed;
      --accent-300: #82a2e3;
      --accent-400: #5883da;
      --accent-500: #2e64d1;
      --accent-600: #2550a7;
      --accent-700: #1c3c7d;
      --accent-800: #122854;
      --accent-900: #09142a;
      --accent-950: #050a15;
    }

    .dark {
      --text-50: #060b13;
      --text-100: #0d1526;
      --text-200: #192a4d;
      --text-300: #264073;
      --text-400: #335599;
      --text-500: #406abf;
      --text-600: #6688cc;
      --text-700: #8ca6d9;
      --text-800: #b3c3e6;
      --text-900: #d9e1f2;
      --text-950: #ecf0f9;
      
      --background-50: #0c0c0e;
      --background-100: #17191c;
      --background-200: #2e3138;
      --background-300: #464a53;
      --background-400: #5d636f;
      --background-500: #747c8b;
      --background-600: #9096a2;
      --background-700: #acb0b9;
      --background-800: #c7cad1;
      --background-900: #e3e5e8;
      --background-950: #f1f2f3;
      
      --primary-50: #060a14;
      --primary-100: #0b1528;
      --primary-200: #162950;
      --primary-300: #223e77;
      --primary-400: #2d539f;
      --primary-500: #3868c7;
      --primary-600: #6086d2;
      --primary-700: #88a4dd;
      --primary-800: #afc2e9;
      --primary-900: #d7e1f4;
      --primary-950: #ebf0f9;
      
      --secondary-50: #050a14;
      --secondary-100: #0a1429;
      --secondary-200: #142952;
      --secondary-300: #1f3d7a;
      --secondary-400: #2952a3;
      --secondary-500: #3366cc;
      --secondary-600: #5c85d6;
      --secondary-700: #85a3e0;
      --secondary-800: #adc2eb;
      --secondary-900: #d6e0f5;
      --secondary-950: #ebf0fa;
      
      --accent-50: #050a15;
      --accent-100: #09142a;
      --accent-200: #122854;
      --accent-300: #1c3c7d;
      --accent-400: #2550a7;
      --accent-500: #2e64d1;
      --accent-600: #5883da;
