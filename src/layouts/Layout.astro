      --accent-950: #eaf0fa;
    }
  }

  @layer components {
    .link {
      @apply underline text-accent-600 hover:text-accent-700;
    }
  }

  html {
    @apply bg-background-50 text-text-950 min-h-screen;
  }

  .content-container {
    @apply px-4 sm:px-6 md:px-16 lg:px-32 xl:px-48 2xl:px-64;
  }

  .btn {
    @apply px-4 py-2 text-text-950 bg-background-200 hover:bg-background-300 rounded-md cursor-pointer transition-colors;
  }

  .btn-group {
    @apply flex gap-0;

    .btn {
      @apply rounded-none;
    }

    :first-child {
      @apply rounded-l-md;
    }

    :last-child {
      @apply rounded-r-md;
    }
  }

  .btn-hidden {
    @apply bg-background-100 hover:bg-background-200;
  }

  .btn-primary {
    @apply bg-primary-800 hover:bg-primary-700 text-text-100;
  }

  .btn-secondary {
    @apply bg-secondary-400 hover:bg-secondary-300;
  }

  .btn-accent {
    @apply bg-accent-500 hover:bg-accent-600;
  }

  .btn-sm {
    @apply px-2 py-1 text-sm;
  }

  .prose-styles {
    @apply prose-headings:font-bold prose-h1:text-2xl prose-h2:text-xl prose-h3:text-lg prose-h4:text-base prose-code:font-body;

    a {
      @apply underline text-accent-600 hover:text-accent-700 transition-colors;
    }
  }

  .card {
    @apply bg-background-100 p-4 rounded-md shadow-md relative flex flex-col gap-1 border-2 border-transparent hover:border-primary-500 transition-all ;

    img {
      @apply top-0 left-0 w-full aspect-video object-cover rounded-md;
    }
  }
</style>
